# BidSure environment configuration (copy to .env and fill in)

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/bidsure?schema=public"

# --- Extraction provider selection (plan §9) ---
# mock  = BIDSURE-MOCK-EXTRACT dev adapter (fixtures only)
# ocr   = local OCR provider (default for real PDFs/images)
# cloud = cloud adapter when credentials exist, falls back to ocr otherwise
BIDSURE_EXTRACTION_PROVIDER=ocr
# In dev/test, documents containing the BIDSURE-MOCK-EXTRACT marker use the
# mock adapter automatically. In production this is disabled unless set to 1.
BIDSURE_ALLOW_MOCK_EXTRACTION=

# --- Cloud OCR adapter (optional; used when BIDSURE_EXTRACTION_PROVIDER=cloud) ---
OCR_PROVIDER=google-vision
GOOGLE_VISION_API_KEY=
# Optional full-endpoint override for a self-hosted/vendor OCR API:
OCR_ENDPOINT=

# --- Authoritative registry provider (plan §17) ---
# When both are set, real KYC-aggregator lookups (GSTIN/PAN/UDYAM) replace the
# mock demo registry. Without them the mock DB registry stays active and, in
# production, mock-backed checks are capped at NEEDS_REVIEW.
REGISTRY_AGGREGATOR_URL=
REGISTRY_AGGREGATOR_API_KEY=

# --- Production mock-registry escape hatch (plan §19) ---
# Set to 1 ONLY in demo/staging environments to keep mock registry verdicts
# (VERIFIED/NON_COMPLIANT) instead of the production NEEDS_REVIEW cap.
BIDSURE_ALLOW_MOCK_REGISTRY=
